{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build: Debug",
            "detail": "DNN Manager, debug (target/debug)",
            "type": "process",
            "command": "cargo",
            "args": ["build", "-p", "dnnmanager"],
            // Every task is in the build group without a default, so Ctrl+Shift+B lists them all.
            "group": "build",
            "problemMatcher": "$rustc",
            "presentation": { "reveal": "always", "panel": "shared", "clear": true }
        },
        {
            "label": "Build: Release",
            "detail": "Optimised, no console window (target/release)",
            "type": "process",
            "command": "cargo",
            "args": ["build", "--release", "-p", "dnnmanager"],
            "group": "build",
            "problemMatcher": "$rustc",
            "presentation": { "reveal": "always", "panel": "shared", "clear": true }
        },
        {
            "label": "Run",
            "detail": "Build and start DNN Manager (asks for administrator rights on Windows)",
            "type": "process",
            "command": "cargo",
            "args": ["run", "-p", "dnnmanager"],
            "group": "build",
            "problemMatcher": "$rustc",
            "presentation": { "reveal": "always", "panel": "shared", "clear": true }
        },
        {
            "label": "Test",
            "detail": "Every crate's tests - no IIS or administrator rights needed",
            "type": "process",
            "command": "cargo",
            "args": ["test", "--workspace"],
            "group": "build",
            "problemMatcher": "$rustc",
            "presentation": { "reveal": "always", "panel": "shared", "clear": true }
        },
        {
            "label": "Clippy",
            "type": "process",
            "command": "cargo",
            "args": ["clippy", "--workspace", "--all-targets"],
            "group": "build",
            "problemMatcher": "$rustc",
            "presentation": { "reveal": "always", "panel": "shared", "clear": true }
        },
        {
            // This PC's package (.msi on Windows, .dmg on macOS, .deb on Linux) into dist\ - see .docs/releasing.md.
            // Needs cargo-packager: cargo install cargo-packager --locked. It takes the exe from dist.
            "label": "Package",
            "detail": "This system's installer into dist",
            "type": "shell",
            "command": "cargo build --release -p dnnmanager && pwsh -NoProfile -Command \"New-Item -ItemType Directory -Force dist | Out-Null; Copy-Item target/release/DnnManager* dist/ -Exclude *.d,*.pdb\" && cargo packager --release --out-dir dist",
            "windows": {
                "options": { "shell": { "executable": "powershell.exe", "args": ["-NoProfile", "-Command"] } },
                "command": "cargo build --release -p dnnmanager; if ($?) { New-Item -ItemType Directory -Force dist | Out-Null; Copy-Item target/release/DnnManager.exe dist/; cargo packager --release --formats wix --out-dir dist }"
            },
            "group": "build",
            "problemMatcher": "$rustc",
            "presentation": { "reveal": "always", "panel": "shared", "clear": true }
        },
        {
            // Executable or installer, then the systems - several at once (the multi-select comes from the extension
            // Tasks Shell Input, augustocdias.tasks-shell-input). Into dist\ (scripts/publish.ps1). This PC compiles for
            // its own operating system only; the others are skipped with a note - the release on GitHub builds all.
            "label": "Publish",
            "detail": "Executable or installer, then the systems - into dist",
            "type": "process",
            "command": "powershell",
            "osx": { "command": "pwsh" },
            "linux": { "command": "pwsh" },
            "args": [
                "-NoProfile", "-ExecutionPolicy", "Bypass",
                "-File", "${workspaceFolder}/scripts/publish.ps1",
                "-Kind", "${input:publishKind}",
                "-Platform", "${input:publishPlatforms}"
            ],
            "group": "build",
            "problemMatcher": "$rustc",
            "presentation": { "reveal": "always", "panel": "shared", "clear": true }
        },
        {
            // Tags the version in Cargo.toml with the label picked and pushes it; GitHub builds every package and
            // publishes the release with that label (scripts/release.ps1, .github/workflows/release.yml).
            "label": "Release: Github",
            "detail": "Tag vX.Y.Z and push - GitHub builds and publishes",
            "type": "process",
            "command": "powershell",
            "osx": { "command": "pwsh" },
            "linux": { "command": "pwsh" },
            "args": [
                "-NoProfile", "-ExecutionPolicy", "Bypass",
                "-File", "${workspaceFolder}/scripts/release.ps1",
                "-Label", "${input:releaseLabel}"
            ],
            "group": "build",
            "problemMatcher": [],
            "presentation": { "reveal": "always", "panel": "dedicated", "focus": true, "clear": true }
        }
    ],
    "inputs": [
        {
            "id": "publishKind",
            "type": "pickString",
            "description": "What to build",
            "options": [
                { "label": "$(file-binary) Executable - one program, nothing to install", "value": "executable" },
                { "label": "$(package) Installer - the executable and its .msi (Windows), .dmg (macOS), .deb (Linux)", "value": "installer" }
            ],
            "default": "executable"
        },
        {
            // Several at once (Tasks Shell Input's multiselect). The list is right here: each line is
            // value|label|description, PowerShell only prints them back. The picked values go to publish.ps1 as one
            // comma-separated -Platform. This PC builds its own operating system's; the others are skipped.
            "id": "publishPlatforms",
            "type": "command",
            "command": "shellCommand.execute",
            "args": {
                "command": "powershell",
                "commandArgs": [
                    "-NoProfile", "-Command",
                    "'windows-x86_64|$(window) Windows x64|DnnManager-windows-x86_64 .exe / .msi',",
                    "'windows-arm64|$(window) Windows ARM64|DnnManager-windows-arm64 .exe / .msi - needs the MSVC ARM64 build tools',",
                    "'macos-arm64|$(device-desktop) macOS Apple silicon|DnnManager-macos-arm64 .dmg - built on a Mac',",
                    "'macos-x86_64|$(device-desktop) macOS Intel|DnnManager-macos-x86_64 .dmg - built on a Mac',",
                    "'linux-amd64|$(terminal-debian) Linux amd64|DnnManager-linux-amd64 .deb - built on Linux',",
                    "'linux-arm64|$(terminal-debian) Linux arm64|DnnManager-linux-arm64 .deb - built on Linux',",
                    "'linux-x86_64|$(terminal-linux) Linux x86_64|DnnManager-linux-x86_64 .deb - built on Linux',",
                    "'linux-aarch64|$(terminal-linux) Linux aarch64|DnnManager-linux-aarch64 .deb - built on Linux'"
                ],
                "description": "Which systems? This PC builds its own operating system's; the others are skipped",
                "fieldSeparator": "|",
                "multiselect": true,
                "multiselectSeparator": ",",
                "rememberPrevious": true,
                "taskId": "publishPlatforms"
            }
        },
        {
            "id": "releaseLabel",
            "type": "pickString",
            "description": "Release label - Latest is what every DNN Manager's update check offers",
            "options": [
                { "label": "$(circle-slash) None - published, but not the latest", "value": "none" },
                { "label": "$(beaker) Pre-release - label it as not ready for production", "value": "prerelease" },
                { "label": "$(star-full) Latest - label it as the latest for this repository", "value": "latest" }
            ],
            "default": "latest"
        }
    ]
}
